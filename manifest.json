  "ventoy": {
    "config_source": "ventoy/ventoy.json",
    "config_destination": "ventoy/ventoy.json",
    "install_latest": true,
    "force_normal_mode_suffix": "_VTNORMAL.iso"
  },
  "updater": {
    "default_profile": "full",
    "state_file": ".it-toolkit-state.tsv",
    "download_retry_count": 3
  },
  "installer": {
    "require_admin": true,
    "require_usb_confirmation": true,
    "allow_fixed_disks": false,
    "verify_downloads": true,
    "continue_on_optional_download_failure": true
  }
