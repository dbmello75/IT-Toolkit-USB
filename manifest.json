{
  "project": {
    "name": "IT Toolkit USB",
    "description": "Automated Ventoy-based USB toolkit for IT technicians",
    "schema_version": 1,
    "version": "0.1.0"
  },

  "profiles": {
    "standard": {
      "name": "Standard Technician",
      "description": "Essential operating system, recovery, cloning and maintenance tools"
    },
    "full": {
      "name": "Full Technician",
      "description": "Complete toolkit including operating systems, recovery, antivirus and virtualization"
    },
    "recovery": {
      "name": "Recovery Toolkit",
      "description": "Focused on disk, partition, file and operating system recovery"
    },
    "custom": {
      "name": "Custom Installation",
      "description": "Allow the technician to manually select components"
    }
  },

  "directories": [
    "ISO/Windows",
    "ISO/Recovery",
    "ISO/Antivirus",
    "ISO/Linux",
    "ISO/Virtualization",
    "ISO/Network",
    "tools",
    "ventoy"
  ],

  "components": [
