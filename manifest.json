      "id": "windows11-en",
      "name": "Windows 11 x64 - English",
      "description": "Microsoft Windows 11 installation media in English",
      "category": "Windows",
      "type": "iso",
      "destination": "ISO/Windows",
      "filename": "Windows11-English-x64.iso",

      "profiles": [
        "standard",
        "full"
      ],

      "download": {
        "enabled": true,
        "method": "dynamic",
        "provider": "microsoft",
        "url": null
      },

      "checksum": {
        "algorithm": "sha256",
        "required": false,
        "value": null
      },

      "enabled": true
    },

